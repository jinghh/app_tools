<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      权限策略：
      - 视频/GIF 导入导出走系统文件选择器（SAF），无需存储权限
      - 下载 X 视频需要 INTERNET（yt-dlp-android 的 AAR 也会声明该权限）
      - media3-exoplayer 会声明 ACCESS_NETWORK_STATE / WAKE_LOCK（普通权限，保留）
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      下载必须在**前台服务**里维持进程前台状态。原因：
      App 退到后台会进入 cached 进程状态，Android 11+ 的 Cached Apps Freezer 会对整个进程
      SIGSTOP（所有线程停摆、不再读 socket → 下载超时失败），进程也可能被系统直接回收。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 要求前台服务声明类型并持有对应权限，否则 startForeground 抛 SecurityException -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ 发通知需运行时授权；未授权时服务仍可运行，仅通知不显示 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      yt-dlp-android 的 AAR 请求 WRITE_EXTERNAL_STORAGE（maxSdkVersion=28）。
      Android manifest 合并器会因此自动推导出 READ_EXTERNAL_STORAGE，
      两者都显式剔除；本 App 的导入导出全程使用 SAF，不需要任何存储权限。
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyAppTools">
        <!--
          allowBackup=false：CookieStore 承诺登录 Cookie「仅保存在应用私有目录，不外传」，
          而系统云备份 / adb backup 会把它们带离设备（PRD 7 隐私要求）。
          本 App 无值得备份的用户数据（偏好丢了重设即可），整体关闭最稳妥。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 分享直达：浏览器 / 微信里「分享文本」直接进下载页并自动提取链接 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 下载前台服务：把进程保持在前台，避免退到后台被冻结/回收 -->
        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
